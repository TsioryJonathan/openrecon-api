# Async Postgres URL (required)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/openrecon

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# API key required by /api/investigations/* — 503 if unset (fail-closed)
API_KEY=change-me

# HMAC secret for identity assertions (X-User-Id/X-User-Exp/X-User-Sig).
# Must match the UI's USER_SIGNING_SECRET. 503 if unset (fail-closed).
USER_SIGNING_SECRET=change-me-too

# Local dev only: also accept requests with no identity headers at all
AUTH_ALLOW_DEGRADED=true

# Server port
PORT=10000
